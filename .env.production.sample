# ==============================================================================
# LUGIE GLOBAL CONSULTANCY — PRODUCTION ENVIRONMENT CONFIGURATION
# Tagline: "Dream Beyond Borders"
# ==============================================================================

# Core Application Environment
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_secure_64_character_random_hex_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL 16)
POSTGRES_USER=lugie
POSTGRES_PASSWORD=generate_a_secure_database_password_here
POSTGRES_DB=lugie
DATABASE_URL=postgresql+asyncpg://lugie:generate_a_secure_database_password_here@postgres:5432/lugie

# Caching & Session Storage (Redis 7.2)
REDIS_URL=redis://redis:6379/0

# Storage / Document S3 (MinIO or AWS S3)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=lugie_s3_admin_access_key
S3_SECRET_KEY=lugie_s3_admin_secret_key
S3_BUCKET_NAME=lugie-documents
S3_QUARANTINE_BUCKET=lugie-quarantine
S3_REGION=ap-south-1

# CORS & Domain Settings
CORS_ORIGINS=https://lugie.com,https://www.lugie.com,http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/proxy

# ==============================================================================
# PAYMENT GATEWAYS (SANDBOX VS PRODUCTION)
# ------------------------------------------------------------------------------
# NOTE: The platform currently operates in a fully functional SANDBOX SIMULATION
# mode (order creation, reference assignment, and receipt generation).
# When you decide to invest and activate live card/UPI processing:
# 1. Fill in your Razorpay or Stripe credentials below.
# 2. Restart the containers.
# 3. The checkout interface will instantly transition to live gateway processing.
# ==============================================================================

# Option A: Razorpay (India Preferred: UPI, NetBanking, RuPay, Cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Option B: Stripe (International Cards, Apple Pay, Google Pay)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email & Verification (Brevo - 9,000 Free Emails/Month)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=admissions@lugie.com
BREVO_FROM_NAME=Lugie Global Consultancy

# Mobile Phone OTP (Firebase Phone Auth - 10,000 Free SMS OTPs/Month)
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
