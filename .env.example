# === Backend ===

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lugie
POSTGRES_PASSWORD=lugie_dev_password
POSTGRES_DB=lugie

# Security
SECRET_KEY=dev-only-change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO for local dev)
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=lugie-documents
S3_QUARANTINE_BUCKET=lugie-quarantine
S3_REGION=us-east-1

# ClamAV (optional — leave empty to disable)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Email (console = logs to stdout)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@lugie.com

# AI (empty = disabled)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Payment (empty = sandbox/disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# General
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# === Frontend ===
NEXT_PUBLIC_APP_NAME=Lugie Global Consultancy
NEXT_PUBLIC_APP_TAGLINE=Dream Beyond Borders
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only (never exposed to browser)
INTERNAL_API_URL=http://localhost:8000
JWT_SECRET=dev-only-change-this-to-a-random-64-char-string-in-production
